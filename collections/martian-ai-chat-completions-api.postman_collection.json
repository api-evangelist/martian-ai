  "info": {
    "_postman_id": "ecab69d8-66b6-4836-a349-130e9d2f1c26",
    "name": "Martian Gateway Chat Completions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "OpenAPI specification for the Martian Gateway, an LLM model router. The Gateway exposes an OpenAI-compatible chat completions endpoint, an Anthropic Messages-compatible endpoint, and a models listing endpoint. Requests are routed dynamically across a catalog of provider models. Models are addressed with a provider/model-name string (for example, openai/gpt-4.1-nano).\n\nContact Support:\n Name: Martian",
      "type": "text/plain"
    }
  }
